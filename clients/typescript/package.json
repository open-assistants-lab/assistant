{
  "name": "@open-assistants-lab/assistant-sdk",
  "version": "0.1.0-preview.1",
  "description": "Typed TypeScript client SDK for the Assistant API (REST, SSE streaming, WS conversation protocol). Preview \u2014 non-frozen contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm run build",
    "publish:preview": "npm publish --tag preview"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "assistant",
    "agent",
    "client",
    "sdk",
    "sse",
    "websocket"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}