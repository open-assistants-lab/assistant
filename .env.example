# ================================
# Assistant — Environment
# ================================
# Copy this file to .env and fill in your values.
# Secrets and infrastructure only. Put agent behavior, verification,
# summarization, and observability behavior in config.yaml.

# API bind and connection authentication
API_KEY=
SOLO_BYPASS=true
API_HOST=0.0.0.0
API_PORT=8080

# Deployment storage (both roots are required for persistent containers)
DEPLOYMENT_MODE=solo
DEPLOYMENT_DATA_PATH=data
DEPLOYMENT_DATA_ROOT=

# Logging infrastructure
LOGGING_LEVEL=info
LOGGING_JSON_DIR=data/logs

# ================================
# LLM Provider API Keys
# ================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama (local or cloud)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# ================================
# Web Scraping (Firecrawl)
# ================================
FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=  # For self-hosted, e.g., http://localhost:3002

# ================================
# Langfuse (optional - observability)
# ================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Host, enabled state, and environment belong in config.yaml.

# ================================
# OAuth Credentials (Google Workspace)
# ================================
# Set to your Google Cloud OAuth Desktop client credentials to enable
# out-of-the-box Google Workspace integration.
# EMAIL_GWS_CLIENT_ID=
# EMAIL_GWS_CLIENT_SECRET=
# EMAIL_M365_CLIENT_ID=

# ConnectKit Vault Key — set to persist OAuth tokens across restarts
# CONNECTKIT_VAULT_KEY=
