# ================================
# Assistant — Environment
# ================================
# Copy this file to .env and fill in your values.
# Secrets and infrastructure only. Put agent behavior, verification,
# summarization, and observability behavior in config.yaml.

# API bind and connection authentication
API_KEY=
SOLO_BYPASS=true
API_HOST=0.0.0.0
API_PORT=8080

# Deployment storage (both roots are required for persistent containers)
DEPLOYMENT_MODE=solo
DEPLOYMENT_DATA_PATH=data
DEPLOYMENT_DATA_ROOT=

# Logging infrastructure
LOGGING_LEVEL=info
LOGGING_JSON_DIR=data/logs

# ================================
# LLM Provider API Keys
# ================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama Cloud (models configured as ollama-cloud:<model>)
# OLLAMA_BASE_URL selects the ollama-cloud endpoint; it does not configure
# the local ollama: provider.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Ollama Local (models configured as ollama:<model>, OpenAI-compatible /v1 API)
# A container's localhost is the container, not the host daemon. On Docker
# Desktop, use the host gateway address below. On Linux, extra_hosts only maps
# the name: Ollama must also be bridge-reachable (firewall-restricted) or sit
# behind a local bridge-only reverse proxy; never expose it publicly.
# OLLAMA_LOCAL_BASE_URL=http://host.docker.internal:11434/v1

# ================================
# Web Scraping (Firecrawl)
# ================================
FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=  # For self-hosted, e.g., http://localhost:3002

# ================================
# Langfuse (optional - observability)
# ================================
LANGFUSE_ENABLED=true
# Per-deployment endpoint (self-hosted or cloud)
# LANGFUSE_HOST=https://langfuse.example.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Host, enabled state, and environment belong in config.yaml.

# ================================
# OAuth Credentials (Google Workspace)
# ================================
# Set to your Google Cloud OAuth Desktop client credentials to enable
# out-of-the-box Google Workspace integration.
# EMAIL_GWS_CLIENT_ID=
# EMAIL_GWS_CLIENT_SECRET=
# EMAIL_M365_CLIENT_ID=

# ConnectKit Vault Key — set to persist OAuth tokens across restarts
# CONNECTKIT_VAULT_KEY=
